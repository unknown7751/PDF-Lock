# PDFLock configuration — copy to `.env` and adjust. All values shown are safe defaults.
# The backend reads PDFLOCK_* variables (from the environment, or from ./.env / ../.env).
# NEVER put real passwords or secrets in this file; PDFLock needs none.

# ---- Upload limits (also advertised to the UI via GET /api/config) ----
PDFLOCK_MAX_FILE_SIZE_MB=50
PDFLOCK_MAX_TOTAL_SIZE_MB=200
PDFLOCK_MAX_FILES=20
PDFLOCK_MAX_PAGES=2000

# ---- Job lifecycle ----
# Seconds a finished batch stays downloadable before its files are deleted.
PDFLOCK_JOB_TTL_SECONDS=900
PDFLOCK_CLEANUP_INTERVAL_SECONDS=30
PDFLOCK_MAX_ACTIVE_JOBS=25

# ---- Processing ----
# Files processed in parallel (each in its own killable subprocess).
PDFLOCK_MAX_CONCURRENCY=3
# Hard per-file limit; the worker process is killed when exceeded.
PDFLOCK_PROCESSING_TIMEOUT_SECONDS=120

# ---- Storage ----
# Leave unset to use <system temp>/pdflock-jobs. Must NOT be a publicly served directory.
# PDFLOCK_TEMP_ROOT=/var/lib/pdflock/jobs
# Refuse new jobs when free disk space would drop below this.
PDFLOCK_MIN_FREE_DISK_MB=256

# ---- CORS ----
# Comma-separated browser origins allowed to call the API directly.
# Not needed when the UI and API share an origin (Vite proxy in dev, nginx in Docker).
PDFLOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (build-time, read by Vite) ----
# Leave empty for same-origin /api. Set only if the API is on another origin,
# e.g. https://api.example.com (then add the UI origin to PDFLOCK_CORS_ORIGINS).
VITE_API_BASE=
# Only when set does the UI show a GitHub link.
VITE_GITHUB_URL=
# Dev server only: where the Vite proxy forwards /api.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
